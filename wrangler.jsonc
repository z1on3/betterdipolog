{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "vinext/server/fetch-handler",
  "name": "betterdipolog",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "cache": {
    "enabled": true,
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "betterdipolog",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "betterdipolog-bangon",
      "database_id": "16579494-75c6-4a38-a871-9787f21705af",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "NEXT_PUBLIC_WEATHER_CITY_ID": "1715348",
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "6870a76710dc4041aabfc0f1d5298940",
    },
    {
      "binding": "WEATHER_CACHE",
      "id": "de62889de35b43e189aa5b8604555e03",
    },
  ],
  // Edge rate limit for public forms (lib/formGuard.ts): 3 submissions per
  // minute per IP per form. namespace_id is any account-unique integer string.
  "ratelimits": [
    {
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
}
